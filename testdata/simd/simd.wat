  ;; v128 globals, locals, and block results
  (func (export "plumbing") (param v128) (result v128)
    (local v128)
    global.get $g
    local.set 1
    (block (result v128)
      local.get 0
      local.get 1
      v128.xor)
    global.set $g
    global.get $g)
  ;; scalar-in/scalar-out sanity checks, callable without v128 values
  (func (export "sum16") (param i32) (result i32)
    (local $v v128)
    local.get 0
    i8x16.splat
    i16x8.extadd_pairwise_i8x16_u
    i32x4.extadd_pairwise_i16x8_u
    local.set $v
    (i32.add
      (i32.add (i32x4.extract_lane 0 (local.get $v)) (i32x4.extract_lane 1 (local.get $v)))
      (i32.add (i32x4.extract_lane 2 (local.get $v)) (i32x4.extract_lane 3 (local.get $v)))))
  (func (export "addsat") (param i32 i32) (result i32)
    (i8x16.add_sat_s (i8x16.splat (local.get 0)) (i8x16.splat (local.get 1)))
    i8x16.extract_lane_s 9)
  (func (export "mulf") (param f32 f32) (result f32)
    (f32x4.mul (f32x4.splat (local.get 0)) (f32x4.splat (local.get 1)))
    f32x4.extract_lane 2)
  (func (export "memrt") (param i32) (result i32)
    (v128.store (i32.const 16) (i32x4.splat (local.get 0)))
    (v128.load (i32.const 16))
    i32x4.bitmask)
)
