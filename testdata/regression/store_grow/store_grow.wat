(module
  (memory 1)
  (func $alloc (result i32)
    (drop (memory.grow (i32.const 1)))
    i32.const 12345)
  (func (export "test") (result i32)
    (i32.store (i32.const 0) (call $alloc))
    (i32.load (i32.const 0)))
  (func (export "grow_mid") (result i32) (local $off i32)
    (local.set $off (i32.shl (memory.size) (i32.const 16)))
    (i32.store (local.get $off) (call $alloc))
    (i32.load (local.get $off)))
  (func (export "size") (result i32)
    (memory.size)))
